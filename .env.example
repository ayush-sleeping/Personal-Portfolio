# Local-only configuration for the Google Sheets content pipeline.
#
# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# NOTE: the website itself needs none of this. It is a static site and reads
# only the committed assets/data/*.json. These variables exist so you can run
# scripts/fetch-sheet.mjs locally to pull the sheet and preview the result
# before (or instead of) triggering the GitHub Action.
#
# In CI these same two names are GitHub repository secrets, not a .env file:
#   Settings -> Secrets and variables -> Actions

# The long id in your sheet URL, between /d/ and /edit
SHEET_ID=

# Google Cloud API key, restricted to the Google Sheets API.
# Read-only usage. Do NOT enable billing on that GCP project.
GOOGLE_API_KEY=
